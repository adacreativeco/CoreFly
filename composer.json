{
    "name": "corefly/intranet-system",
    "description": "CoreFly - Kapsamlı Kurumsal İntranet Sistemi",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreFly Ekibi",
            "email": "info@corefly.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.0",
        "phpmailer/phpmailer": "^6.8",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.5",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "CoreFly\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreFly\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=8",
        "format": "phpcs --standard=PSR12 src",
        "format-fix": "phpcbf --standard=PSR12 src"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}