# CoreFly Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=corefly
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# Application Configuration
APP_NAME=CoreFly
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr

# Security Configuration
CSRF_PROTECTION=true
SESSION_LIFETIME=120
PASSWORD_MIN_LENGTH=8
PASSWORD_COMPLEXITY=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=3600

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@corefly.com
MAIL_FROM_NAME="CoreFly Sistemi"

# File Storage Configuration
FILESYSTEM_DISK=local
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,gif,zip,rar
UPLOAD_PATH=storage/uploads

# Cache Configuration
CACHE_DRIVER=file
CACHE_LIFETIME=3600

# Logging Configuration
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Multi-tenant Configuration
MULTI_TENANT_ENABLED=true
TENANT_IDENTIFICATION=domain
DEFAULT_TENANT=default

# Feature Flags
ANNOUNCEMENTS_MODULE=true
DOCUMENTS_MODULE=true
TASKS_MODULE=true
PROJECTS_MODULE=true
CALENDAR_MODULE=true
MESSAGING_MODULE=true
HELPDESK_MODULE=true
FIELD_MANAGEMENT_MODULE=true
NGO_MODULE=true
INVENTORY_MODULE=true